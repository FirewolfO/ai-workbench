[Unit]
Description=AI Workbench API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/ai-workbench/backend
EnvironmentFile=-%h/code/ai-workbench/backend/.env
ExecStartPre=/usr/bin/mkdir -p %h/code/ai-workbench/.runtime/bin
ExecStartPre=/usr/local/go/bin/go build -o %h/code/ai-workbench/.runtime/bin/ai-workbench-server ./cmd/server
ExecStart=%h/code/ai-workbench/.runtime/bin/ai-workbench-server
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
