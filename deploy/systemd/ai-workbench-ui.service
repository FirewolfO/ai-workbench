[Unit]
Description=AI Workbench UI
After=network-online.target ai-workbench-api.service
Wants=network-online.target ai-workbench-api.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/ai-workbench/frontend
EnvironmentFile=-%h/code/ai-workbench/frontend/.env
ExecStart=/usr/bin/node %h/code/ai-workbench/frontend/node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5181 --strictPort
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
